# android/fastlane/Fastfile
opt_out_usage
default_platform(:android)

platform :android do

  desc "Verify that Google Play service account JSON key exists and is valid"
  lane :validate_key do
    key_path = File.expand_path("../play-store-key.json", __dir__)
    unless File.exist?(key_path)
      UI.user_error!("Service account key not found at #{key_path}. Please place your Google Play service account JSON file there.")
    end
    UI.success("Found Google Play service account key at: #{key_path}")
    validate_play_store_json_key(
      json_key: key_path
    )
    UI.success("Google Play API credentials validated successfully!")
  end

  desc "Build Flutter Release Android App Bundle (AAB)"
  lane :build do
    root_dir = File.expand_path("../../", __dir__)
    UI.message("Building Flutter App Bundle from: #{root_dir}")
    sh("cd #{root_dir} && flutter build appbundle --release")
  end

  desc "Build and upload release to Google Play Internal Testing track"
  lane :internal do
    build
    aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__)
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
    UI.success("Successfully uploaded to Google Play Internal Testing!")
  end

  desc "Build and upload release to Google Play Closed Testing (Alpha) track"
  lane :alpha do
    build
    aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__)
    upload_to_play_store(
      track: "alpha",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
    UI.success("Successfully uploaded to Google Play Closed Testing (Alpha)!")
  end

  desc "Alias for alpha track (Closed Testing)"
  lane :closed do
    alpha
  end

  desc "Build and upload release to Google Play Open Testing (Beta) track"
  lane :beta do
    build
    aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__)
    upload_to_play_store(
      track: "beta",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
    UI.success("Successfully uploaded to Google Play Open Testing (Beta)!")
  end

  desc "Build and upload release to Google Play Production track"
  lane :production do |options|
    build
    aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__)
    rollout = options[:rollout] # optional rollout percentage e.g. "0.2" for 20%
    
    upload_params = {
      track: "production",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }
    upload_params[:rollout] = rollout if rollout

    upload_to_play_store(upload_params)
    UI.success("Successfully released to Google Play Production!")
  end

  desc "Promote an existing release from Internal track to Production"
  lane :promote_internal_to_production do |options|
    rollout = options[:rollout]
    upload_params = {
      track: "internal",
      track_promote_to: "production",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }
    upload_params[:rollout] = rollout if rollout

    upload_to_play_store(upload_params)
    UI.success("Successfully promoted Internal release to Production!")
  end

  desc "Check current status of releases across all tracks"
  lane :status do
    require "google/apis/androidpublisher_v3"
    require "googleauth"

    key_path = File.expand_path("../play-store-key.json", __dir__)
    package_name = "com.shantinathagroagency.shantinath_agro"

    authorizer = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: File.open(key_path),
      scope: "https://www.googleapis.com/auth/androidpublisher"
    )
    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
    service.authorization = authorizer

    edit = service.insert_edit(package_name, Google::Apis::AndroidpublisherV3::AppEdit.new)
    edit_id = edit.id

    UI.header("Google Play Tracks Status: #{package_name}")
    tracks_response = service.list_edit_tracks(package_name, edit_id)
    tracks_response.tracks.each do |track|
      puts "\nTrack: #{track.track.upcase}".bold.blue
      if track.releases.nil? || track.releases.empty?
        puts "  No active releases."
      else
        track.releases.each do |release|
          puts "  • Release Name   : #{release.name || '(unnamed)'}"
          puts "  • Status         : #{release.status}"
          puts "  • Version Code(s): #{release.version_codes ? release.version_codes.join(', ') : 'none'}"
          puts "  • Rollout        : #{(release.user_fraction * 100).round(1)}%" if release.user_fraction
          if release.release_notes && !release.release_notes.empty?
            release.release_notes.each do |rn|
              puts "  • Notes [#{rn.language}] : #{rn.text}"
            end
          end
        end
      end
    end
    service.delete_edit(package_name, edit_id)
  end

end
